# ==============================================================================
# BÂTI-AXE — TEMPLATE ENVIRONNEMENT & SECRETS GITHUB ACTIONS
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LOCAL DEVELOPMENT (.env local)
# ------------------------------------------------------------------------------

# Supabase Local
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
NODE_ENV=development

# Cloudflare R2 Storage (R-05.14 Multi-Buckets)
R2_ACCOUNT_ID=711bef7095122fdf531555b64f8256e8
R2_ACCESS_KEY_ID=...
R2_SECRET_ACCESS_KEY=...
# Legacy bucket (conservé pour rétrocompatibilité)
NUXT_R2_BUCKET_NAME=batiaxe-documents
# 05.14 — Isolation des 3 buckets R2
NUXT_R2_BUCKET_PUBLIC=batiaxe-public-dev
NUXT_R2_BUCKET_VAULT=batiaxe-vault-dev
NUXT_R2_BUCKET_B2B=batiaxe-b2b-dev

# Stripe Billing (Dev)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PRICE_ID=price_...
STRIPE_WEBHOOK_SECRET=whsec_...
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend Mailing
RESEND_API_KEY=re_...
EMAIL_FROM=BÂTI-AXE <contact@bati-axe.com>
ONBOARDING_EMAILS=true
# 05.15 — reçoit les alertes admin (ex. SIRET non trouvé/en erreur au claim d'un pro)
ADMIN_EMAIL=admin@bati-axe.com

# Turnstile Anti-Spam
NUXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAA...
TURNSTILE_SECRET_KEY=0x4AAAA...

# Analytics Umami
NUXT_PUBLIC_UMAMI_URL=https://bati-axe.com
NUXT_PUBLIC_UMAMI_WEBSITE_ID=e3747b3c-2cf6-4f44-9436-8ebf205f93cd


# ------------------------------------------------------------------------------
# 2. SECRETS GITHUB ACTIONS (A ajouter dans GitHub > Settings > Secrets > Actions)
# ------------------------------------------------------------------------------
# CF_R2_ACCESS_KEY_ID           = Clé S3 R2 pour le state Terraform backend
# CF_R2_SECRET_ACCESS_KEY       = Clé secrète S3 R2 pour le state Terraform backend
# TF_VAR_CLOUDFLARE_ACCOUNT_ID  = ID du compte Cloudflare client (ex: 711bef...)
# TF_VAR_CLOUDFLARE_API_TOKEN   = Token API Cloudflare client (Pages + DNS permissions)
# R2_APP_ACCESS_KEY_ID          = Clé R2 S3 pour l'application Nuxt
# R2_APP_SECRET_ACCESS_KEY      = Clé secrète R2 S3 pour l'application Nuxt
# TF_VAR_SUPABASE_URL           = https://xpwoczcbyamnjknloxgz.supabase.co
# TF_VAR_SUPABASE_ANON_KEY      = Clé anon de Supabase Prod
# TF_VAR_SUPABASE_SERVICE_ROLE_KEY = Clé service_role de Supabase Prod
# TF_VAR_EXISTING_DATABASE_URL  = Connection String Postgres Supabase Prod
# TF_VAR_RESEND_API_KEY         = Clé API Resend (re_...)
# EMAIL_FROM                    = BÂTI-AXE <contact@bati-axe.com>
# TF_VAR_STRIPE_SECRET_KEY      = Clé secrète Stripe prod (sk_live_...)
# TF_VAR_STRIPE_PRICE_ID        = ID prix Stripe prod
# TF_VAR_STRIPE_WEBHOOK_SECRET  = Secret webhook Stripe (whsec_...)
# TURNSTILE_SECRET_KEY          = Clé secrète Turnstile Cloudflare
