# Supabase Local Settings
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# DATABASE
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# NODE ENV
NODE_ENV=development

# Cloudflare R2 (ADR-003) — dashboard.cloudflare.com > R2 > Manage API tokens
R2_ACCOUNT_ID=...
R2_ACCESS_KEY_ID=...
R2_SECRET_ACCESS_KEY=...
R2_BUCKET_NAME=batiaxe-documents

# Bootstrap admin (optionnel — supprimer après première utilisation)
# Permet d'appeler POST /api/v1/admin/promote pour créer le premier admin en prod.
# En local, utiliser supabase/scripts/make-admin.sql directement.
ADMIN_BOOTSTRAP_SECRET=un-secret-long-et-aleatoire

# Phase 4 — Stripe Billing
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PRICE_ID=price_...
STRIPE_WEBHOOK_SECRET=whsec_...
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# Phase 5 — Messagerie (Resend)
# En local, RESEND_API_KEY suffit. Cloudflare utilise NUXT_RESEND_API_KEY.
RESEND_API_KEY=re_...
# Expéditeur des e-mails. Défaut: 'BÂTI-AXE <onboarding@resend.dev>'.
# EMAIL_FROM=BÂTI-AXE <noreply@bati-axe.fr>
# Cloudflare : NUXT_EMAIL_FROM=BÂTI-AXE <noreply@bati-axe.fr>
# Optionnel : forcer l'envoi réel d'e-mails en dev (par défaut mockés en console).
# EMAIL_LIVE=true

# Phase 6 (REQ-07) — Email d'onboarding pro (OFF par défaut)
# ONBOARDING_EMAILS=true
# Cloudflare : NUXT_ONBOARDING_EMAILS=true

# P2 — Cloudflare Turnstile (anti-spam)
# Clé publique (site key) — rendue côté client.
NUXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAA...
# Clé secrète — vérification serveur uniquement.
# TURNSTILE_SECRET_KEY=0x4AAAA...
# Cloudflare : NUXT_TURNSTILE_SECRET_KEY=0x4AAAA...

# Analytics Umami
NUXT_PUBLIC_UMAMI_URL=https://stats.exemple.com
NUXT_PUBLIC_UMAMI_WEBSITE_ID=...

# Cloudflare Pages runtime (géré par Terraform en Dev/Prod)
# Ces variables sont injectées automatiquement par le workflow Terraform.
NUXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NUXT_PUBLIC_SUPABASE_KEY=sb_publishable_...
NUXT_SUPABASE_SECRET_KEY=sb_secret_...
NUXT_STRIPE_SECRET_KEY=sk_test_...
NUXT_STRIPE_PRICE_ID=price_...
NUXT_STRIPE_WEBHOOK_SECRET=whsec_...
NUXT_R2_ACCOUNT_ID=...
NUXT_R2_ACCESS_KEY_ID=...
NUXT_R2_SECRET_ACCESS_KEY=...
NUXT_R2_BUCKET_NAME=batiaxe-documents
NUXT_RESEND_API_KEY=re_...
NUXT_EMAIL_FROM=BÂTI-AXE <onboarding@resend.dev>
NUXT_ONBOARDING_EMAILS=false
NUXT_TURNSTILE_SECRET_KEY=
