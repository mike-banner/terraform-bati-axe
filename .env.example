# ==============================================================================
# BÂTI-AXE — TEMPLATE ENVIRONNEMENT & SECRETS GITHUB ACTIONS
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LOCAL DEVELOPMENT (.env local)
# ------------------------------------------------------------------------------

# Supabase Local
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
NODE_ENV=development

# Cloudflare R2 Storage (R-05.14 Multi-Buckets)
R2_ACCOUNT_ID=711bef7095122fdf531555b64f8256e8
R2_ACCESS_KEY_ID=...
R2_SECRET_ACCESS_KEY=...
# Legacy bucket (conservé pour rétrocompatibilité)
NUXT_R2_BUCKET_NAME=batiaxe-documents
# 05.14 — Isolation des 3 buckets R2
NUXT_R2_BUCKET_PUBLIC=batiaxe-public-dev
NUXT_R2_BUCKET_VAULT=batiaxe-vault-dev
NUXT_R2_BUCKET_B2B=batiaxe-b2b-dev

# Stripe Billing (Dev)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PRICE_ID=price_...
STRIPE_WEBHOOK_SECRET=whsec_...
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend Mailing
RESEND_API_KEY=re_...
EMAIL_FROM=BÂTI-AXE <contact@bati-axe.com>
ONBOARDING_EMAILS=true
# 05.15 — reçoit les alertes admin (ex. SIRET non trouvé/en erreur au claim d'un pro)
ADMIN_EMAIL=admin@bati-axe.com
# 06.3 — expéditeurs dédiés (nécessitent DKIM/SPF/DMARC sur bati-axe.com)
EMAIL_FROM_NO_REPLY=BÂTI-AXE <no-reply@bati-axe.com>
EMAIL_FROM_NOTIFICATIONS=BÂTI-AXE <notifications@bati-axe.com>
EMAIL_FROM_CONTACT=BÂTI-AXE <contact@bati-axe.com>
# 06.3 — secret du cron HTTP alertes décennale (Bearer)
CRON_SECRET=change-me

# Turnstile Anti-Spam
NUXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAA...
TURNSTILE_SECRET_KEY=0x4AAAA...

# Analytics Umami
NUXT_PUBLIC_UMAMI_URL=https://bati-axe.com
NUXT_PUBLIC_UMAMI_WEBSITE_ID=e3747b3c-2cf6-4f44-9436-8ebf205f93cd

# Phase 8 — Garde-fous anti-spam diffusion AO partenaires
# Nombre max d'AO actifs simultanés par partenaire (identifié par contact_email).
# Au-delà : la diffusion est refusée (409) avec un message au DirCo.
B2B_MAX_ACTIVE_TENDERS_PER_PARTNER=3
# Nombre max de notifications AO reçues par artisan et par jour, tous partenaires
# confondus. Au-delà : l'artisan est exclu silencieusement de la diffusion en cours.
B2B_MAX_NOTIFICATIONS_PER_ARTISAN_PER_DAY=5


# ------------------------------------------------------------------------------
# 2. SECRETS GITHUB ACTIONS & EXPORT (node scripts/push-github-secrets.mjs)
# ------------------------------------------------------------------------------
#
# DEV Perso (Votre compte Cloudflare / Supabase)
# DEV_CLOUDFLARE_ACCOUNT_ID        = ID du compte Cloudflare Dev Perso
# DEV_CLOUDFLARE_API_TOKEN          = Token API Cloudflare Dev Perso
# DEV_CF_R2_ACCESS_KEY_ID           = Clé Access R2 S3 State Backend Dev Perso
# DEV_CF_R2_SECRET_ACCESS_KEY       = Clé Secret R2 S3 State Backend Dev Perso
#
# PROD Client (Compte Cloudflare / Supabase Client)
# PROD_CLOUDFLARE_ACCOUNT_ID       = ID du compte Cloudflare Client
# PROD_CLOUDFLARE_API_TOKEN         = Token API Cloudflare Client
# PROD_CF_R2_ACCESS_KEY_ID          = Clé Access R2 S3 State Backend Prod
# PROD_CF_R2_SECRET_ACCESS_KEY      = Clé Secret R2 S3 State Backend Prod
# PROD_R2_APP_ACCESS_KEY_ID         = Clé Access R2 Application Nuxt Prod
# PROD_R2_APP_SECRET_ACCESS_KEY     = Clé Secret R2 Application Nuxt Prod
# PROD_TF_VAR_SUPABASE_URL          = URL Supabase Cloud Prod
# PROD_TF_VAR_SUPABASE_ANON_KEY     = Clé Anon Supabase Prod
# PROD_TF_VAR_SUPABASE_SERVICE_ROLE_KEY = Clé Service Role Supabase Prod
# PROD_TF_VAR_EXISTING_DATABASE_URL = Connection String Postgres Supabase Prod
# PROD_RESEND_API_KEY               = Clé API Resend Prod
# PROD_EMAIL_FROM                   = Expéditeur E-mail Prod
# PROD_TURNSTILE_SECRET_KEY         = Clé Secrète Turnstile Cloudflare Prod
# PROD_R2_BUCKET_PUBLIC             = Nom du bucket public (batiaxe-public-prod)
# PROD_R2_BUCKET_VAULT              = Nom du bucket vault (batiaxe-vault-prod)
# PROD_R2_BUCKET_B2B                = Nom du bucket b2b (batiaxe-b2b-prod)
#
# Stripe Client (Clés de test ou Live)
# CLIENT_STRIPE_TEST_SECRET_KEY     = sk_test_... (Poussé en mode TEST)
# CLIENT_STRIPE_TEST_PRICE_ID       = price_...
# CLIENT_STRIPE_TEST_WEBHOOK_SECRET = whsec_...
# CLIENT_STRIPE_LIVE_SECRET_KEY     = sk_live_... (Poussé dès remplissage)
# CLIENT_STRIPE_LIVE_PRICE_ID       = price_...
# CLIENT_STRIPE_LIVE_WEBHOOK_SECRET = whsec_...

